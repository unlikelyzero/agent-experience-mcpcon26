+      compilation.hooks.processAssets.tap(
+        { name: 'SuffixClassesPlugin', stage: webpack.Compilation.PROCESS_ASSETS_STAGE_SUMMARIZE },
+        (assets) => {
+          const token = new RegExp(`(?<![-\\w])(${SUFFIXED_CLASSES.join('|')})(?![-\\w])`, 'g');
