+    text-align: inherit;
+    vertical-align: baseline;
+    color: buttontext;
+    background: transparent;
+    border: none;
+    border-radius: 0;
+    outline: none;
+    appearance: none;
+    cursor: pointer;
+}
+
 .c-button,
 .c-button--menu {
     @include cButton();
