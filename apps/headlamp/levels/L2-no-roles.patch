diff --git a/frontend/src/lib/ax.ts b/frontend/src/lib/ax.ts
new file mode 100644
index 0000000..c28bb2d
--- /dev/null
+++ b/frontend/src/lib/ax.ts
@@ -0,0 +1,15 @@
+/**
+ * AX L2: spread onto a MUI ButtonBase control (Button, IconButton, Fab, MenuItem) to render
+ * it as a plain div with no role and no tab stop. The look is unchanged: ButtonBase already
+ * resets the native button's styles. `null`, not `undefined`, because MUI defaults
+ * `tabIndex` (and MenuItem's `role`) when the prop is undefined.
+ */
+// eslint-disable-next-line @typescript-eslint/no-explicit-any
+export const asDiv: any = { component: 'div', role: null, tabIndex: null };
+
+/** AX L2: spread into a Dialog's PaperProps to drop `role="dialog"`. */
+export const noDialogRole = { role: undefined };
+
+/** AX L2: MenuListProps for a Menu with no menu or list role and no tab stop. */
+// eslint-disable-next-line @typescript-eslint/no-explicit-any
+export const plainMenuList: any = { component: 'div', role: null, tabIndex: null };
